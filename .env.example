# MapTiler API Key (required for satellite map tiles)
# Get yours at https://cloud.maptiler.com/
NUXT_PUBLIC_MAPTILER_API_KEY=your_api_key_here

# Supabase (required for auth, grants, and community monitoring)
# Get yours at https://supabase.com → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-key-here

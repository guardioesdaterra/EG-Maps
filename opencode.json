{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tiptap": {
      "api": "openai",
      "name": "TiPToP Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:3847/v1",
        "apiKey": "proxy-managed"
      },
      "models": {
        "tiptap-proxy": {
          "id": "tiptap-proxy",
          "name": "TiPToP Proxy",
          "family": "text",
          "attachment": false,
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 32000,
            "output": 4096
          }
        }
      }
    },
    "tokenrouter": {
      "api": "openai",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "glm-5.3-free": {
          "id": "z-ai/glm-5.3-free",
          "name": "GLM 5.3 Free",
          "family": "text",
          "attachment": false,
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "tokenrouter/glm-5.3-free"
}
